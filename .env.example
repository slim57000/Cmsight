# Copy this file to .env for local development and fill in real values.
# In production, set these as Environment Variables in the Vercel project
# settings — never commit real secrets to Git.

# Supabase project (Project Settings > API)
SUPABASE_URL=
# Service role key — server-side only, bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers > API keys)
STRIPE_SECRET_KEY=
# Stripe (Developers > Webhooks > your endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=
# Price ID for "EU Compliance Suite - Licence complète" (one-time payment)
STRIPE_PRICE_ID=price_1UHNgV2cZZwb2lytBbn1U8vk
# Price ID for "Cmsight - Licence à vie" (79€, one-time payment). This
# purchase does NOT generate an automatic license — buyers get an email
# with an access link to their customer portal (account.html) instead.
STRIPE_PRICE_ID_CMSIGHT=price_1UHdhs2cZZwb2lyt4BBuPJlS

# Launch offer: after this date, /api/checkout switches Cmsight purchases
# to STRIPE_PRICE_ID_CMSIGHT_REGULAR (if set) instead of the launch price
# above. Leave LAUNCH_OFFER_END_DATE unset for the offer to never end.
LAUNCH_OFFER_END_DATE=2026-10-05
# Create this price in Stripe once you've decided the post-offer amount —
# checkout keeps using the launch price until this is set, even past the
# end date, so nothing breaks if you're not ready yet.
STRIPE_PRICE_ID_CMSIGHT_REGULAR=

# Shared secret for /admin.html and the admin-only comment routes. Generate
# a long random value yourself — never reuse another secret for this.
ADMIN_API_KEY=

# Resend (resend.com/api-keys) — optional, license emails are skipped if unset
RESEND_API_KEY=
# Verified sender address for license delivery emails, e.g. licenses@yourdomain.com
LICENSE_FROM_EMAIL=

# Where Stripe Checkout redirects after payment. Optional — falls back to
# eu-compliance-suite.html on the request's own origin if unset.
CHECKOUT_SUCCESS_URL=https://cmsight.vercel.app/checkout/success
CHECKOUT_CANCEL_URL=https://cmsight.vercel.app/checkout/cancel

# Base site URL used to build customer-portal access links sent by email.
SITE_URL=https://cmsight.vercel.app

# Cmsight installer download links for the customer portal (account.html).
# Leave unset until the installers are hosted somewhere — the portal shows
# "coming soon" instead of a broken link.
CMSIGHT_DOWNLOAD_URL_WINDOWS=
CMSIGHT_DOWNLOAD_URL_MAC=
CMSIGHT_VERSION=
